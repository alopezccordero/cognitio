# Cognitio environment variables
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. Never commit real keys.
#
# IMPORTANT: everything below is SERVER-ONLY. Do not prefix these with VITE_,
# or Vite will inline them into the public browser bundle.

# --- App ---------------------------------------------------------------
APP_URL=http://localhost:5173
# Secret used to sign session cookies / magic-link tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-me

# --- Auth email (Resend) ----------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain verified in Resend
RESEND_FROM_EMAIL=Cognitio <login@your-domain.com>

# --- Papers (Semantic Scholar Academic Graph API) ---------------------
# https://www.semanticscholar.org/product/api  (key optional but raises rate limits)
SEMANTIC_SCHOLAR_API_KEY=replace-me
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1

# --- LLM (Groq) --------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Check https://console.groq.com/docs/models for currently available models
GROQ_MODEL=replace-with-model-id
